Documentation:
  CommentFormat: Doxygen

CompileFlags:
  Add:
    - "-std=c++20"
    - "-Wno-c23-extensions"
  CompilationDatabase: build/

Index:
  Background: Build
  StandardLibrary: Yes

Completion:
  AllScopes: true

Hover:
  ShowAKA: true

Diagnostics:
  ClangTidy: { FastCheckFilter: Loose }
  UnusedIncludes: Strict
  MissingIncludes: Strict
Completion: { AllScopes: Yes, ArgumentLists: FullPlaceholders, HeaderInsertion: IWYU }
Hover: { ShowAKA: Yes }
InlayHints: { Enabled: Yes, ParameterNames: Yes, DeducedTypes: Yes, Designators: Yes }